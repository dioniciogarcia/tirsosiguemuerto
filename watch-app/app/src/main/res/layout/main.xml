<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.workspacehelper.watch.RingView
        android:id="@+id/ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <TextView
        android:id="@+id/pip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:text="PC —"
        android:textColor="#9AA3B2"
        android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="42dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESKTIME"
            android:textColor="#9AA3B2"
            android:textSize="11sp"
            android:letterSpacing="0.14"/>

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#F4F6FA"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#9AA3B2"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/stop"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/btn_stop"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="STOP"
                android:textColor="#FB7185"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/f9"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_f9"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="F9"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/gear"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/btn_gear"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textColor="#C7CDD9"
        android:textSize="13sp"/>
</FrameLayout>
